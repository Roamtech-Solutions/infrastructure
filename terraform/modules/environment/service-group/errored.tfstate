          "attributes": {
            "bucket": "management-b6d6-values",
            "cache_control": null,
            "content": "tag: 564e40486a9cdf1acafb09fc61939639dfd068ea\nenvironment: development\nport: 8080\nmigration_type: artisan\ntype: php-laravel\n\ningress: true\n\nallowed_networks:\n  codepoint:\n    - 62.215.31.13/32\n    - 168.187.217.69/32\n    - 62.215.31.5/32\n    - 62.215.31.11/32\n    - 62.215.161.67/32\n    - 168.187.187.82/32\n  codepoint_dev: \n    - 117.221.70.75/32\n    - 202.164.154.212/32\n  codepoint_uat:\n    - 3.109.39.95/32\n\nenv:\n  # Core App Config\n  - name: APP_ENV\n    value: local\n  - name: APP_DEBUG\n    value: \"true\"\n  - name: APP_URL\n    value: \"https://gateway.development.afrisend.com/api/v1/\"\n  - name: APP_TIMEZONE\n    value: UTC\n  - name: LOG_SLACK_WEBHOOK_URL\n    value: \"\"\n  - name: MOBILE_TRANSACTION_LIMIT\n    value: \"1000\"\n  - name: SWAGGER_GENERATE_ALWAYS\n    value: \"true\"\n  - name: INSUFFICIENT_BALANCE_MESSAGE\n    value: \"The balance is insufficient for the transaction\"\n  - name: JWT_REFRESH_TTL\n    value: \"20160\"\n  - name: MEMBERCHECK_BASE_URL\n    value: https://demo.api.membercheck.com/api/v2\n  - name: PARTNER_BALANCE_THRESHOLD\n    value: \"100\"\n  - name: TWO_FA_TICKET_TTL\n    value: \"300\"\n\n  # Database (main)\n  - name: DB_DATABASE\n    value: afrisend_gateway\n\n  # Ewallet Database\n  - name: EWALLET_DB_DATABASE\n    value: ewallet\n\n  # Compliance Database\n  - name: COMPLIANCE_DB_DATABASE\n    value: compliancewire\n\n  # Payment Database\n  - name: PAYMENTS_DB_DATABASE\n    value: payments\n\n  # RabbitMQ\n  - name: RABBITMQ_VHOST\n    value: /\n\n  # Partner / Gateway Configs\n  - name: CURFEX_TOKEN_URL\n    value: \"http://emq:8080/api/v1/query/642276b3269cac0c401bfa98\"\n  - name: GATEWAY_ALL_PARTNER_URL\n    value: \"http://emq:8080/public/partners/63f5686995c04c57dd54235a\"\n  - name: GATEWAY_BASE_QUERY_URL\n    value: \"http://emq:8080/api/v1/query/\"\n  - name: GATEWAY_LOGIN_URL\n    value: \"http://emq:8080/public/token/643d330e3c2818b1c71d7829\"\n  - name: INBOUND_GATEWAY_LOGIN_URL\n    value: \"http://emq:8080/public/token/643d330e3c2818b1c71d7829\"\n  - name: GATEWAY_AUTHOTIZE_URL\n    value: \"http://emq:8080/api/v1/query/643d330e3c2818b1c71d7829\"\n  - name: CURFEX_PAYOUT_INFO_URL\n    value: \"http://emq:8080/api/v1/query/64229e5dc24ba7cd97b40b75\"\n  - name: GATEWAY_UNIFIED_RATES_URL\n    value: \"http://emq:8080/api/v1/query/63f5686995c04c57dd54235a\"\n  - name: CURFEX_PARTNER_CODE\n    value: \"64227569810ae1f82c35ff09\"\n  - name: GATEWAY_MFS_BANKS_URL\n    value: \"http://emq:8080/api/v1/query/63f5ca2f92c91442a8b2778d\"\n  - name: INSTANTCASH_CHECK_STATUS\n    value: \"63ea296e3b42bc8f07a495a9\"\n  - name: MFS_PARTNER_CODE\n    value: \"63f4c491384b742dd9e6840a\"\n  - name: MFS_CHECK_STATUS\n    value: \"63f74b410b24da4439389652\"\n  - name: TERRAPAY_PARTNER_CODE\n    value: \"62ea315fb47687d9cbbf6827\"\n  - name: TERRAPAY_TRANSACTION_STATUS\n    value: \"6614fb94c930411b89a0c4db\"\n  - name: INSTANT_CASH_PARTNER_CODE\n    value: \"63f45bf54618c736d556243c\"\n  - name: PARTNER_GATEWAY_LOGIN_SERVICE\n    value: \"643d330e3c2818b1c71d7829\"\n  - name: INBOUND_TRANSACTION_QUERY_SERVICE\n    value: \"64e44b0765915814b832752\"\n  - name: EMQ_BASE_URL\n    value: \"http://emq:8080\"\n  - name: EMQ_GET_URL\n    value: \"/api/v1/query/\"\n\n    # ifast outbound configs\n  - name: IFAST_OB_PARTNER_CODE\n    value: \"662e703e58efaae623aabdc7\"\n  - name: IFAST_OB_AGENTLIST_URL\n    value: \"http://emq:8080/api/v1/query/9a27614481c2021397d6079e\"\n  - name: GATEWAY_IFAST_OUTBOUND_BANKS_URL\n    value: \"http://emq:8080/api/v1/query/d3580c803b04964d509e81d1\"\n  - name: IFAST_TRANSACTION_DETAILS\n    value: \"http://emq:8080/api/v1/query/9a27614481c2021397d6079e\"\n  - name: IFAST_CANCEL_TRANSACTION_URL\n    value: \"http://emq:8080/api/v1/query/72e3ec62c872f4d11506a9aa\"\n  - name: IFAST_PAYMENT_DETAILS_SERVICE_ID\n    value: \"9a27614481c2021397d6079e\"\n  - name: IFAST_FUND_SOURCE_PURPOSE_AND_BANK_SERVICE_ID\n    value: \"d3580c803b04964d509e81d1\"\n  - name: IFAST_PAYOUT_COUNTRIES_SERVICE_ID\n    value: \"9a27614481c2021397d6079e\"\n  - name: IFAST_TRANSFERS_BRANCH_AND_MAX_PAYOUT_SERVICE_ID\n    value: \"9b0c452e22020feef7a17957\"\n  - name: IFAST_PARTNER_UUID\n    value: \"431cac48\"\n\n    # Identifying Paykit in Afrisend\n  - name: PAYKIT_PARTNER_CODE\n    value: \"637892cb4300e020e8f1d3ff\"\n\n  - name: PARTNER_MOBILE_HAKIKISHA_SERVICE\n    value: \"642e7a7fbb0bac496b32ade9\"\n  - name: PARTNER_BANK_BANK_SEND_SERVICE\n    value: \"643678867c60fc2a740932de\"\n  - name: PARTNER_BANK_HAKIKISHA_SERVICE\n    value: \"6436691d2d9e12333e3d2a52\"\n  - name: IPSL_PARTNER_CODE\n    value: \"63f4c83d0d8d0acb095d51c8\"\n  - name: METAMAP_AML_GET_TOKEN_URL\n    value: \"https://api.getmati.com/oauth\"\n  - name: MFS_AC_CHK\n    value: \"63f60b67697abf99fae06a15\"\n  - name: METAMAP_AML_LIST_URL\n    value: \"https://api.getmati.com/safety/v1/checks/comply-advantage\"\n  - name: PARTNER_MOBILE_SEND_SERVICE\n    value: \"544df52ac0e14a0ed8cf6040\"\n\n    # Resource file limits\n  - name: MEMORY_LIMIT\n    value: \"512M\"\n\nsecrets:\n  - APP_KEY\n  - MEMBERCHECK_API_KEY\n  - JWT_SECRET\n  - AFRISEND_IMT_GW_APP_KEY\n  - AFRISEND_IMT_GW_APP_SECRET\n  - TERRAPAY_PARTNER_SECRET\n  - OFAC_SUBSCRIPTION_KEY\n  - IFAST_OB_PARTNER_SECRET\n  - MFS_PARTNER_SECRET\n\nrequires:\n  - mysql\n  - redis\n  - rabbitmq\n\njobs:\n  sync-payout-data:\n    command: [\"php\", \"artisan\", \"ifast:sync-payout-data\"]\n\n",
